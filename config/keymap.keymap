#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

&lt {
    tapping-term-ms = <180>;
    quick-tap-ms = <150>;
    flavor = "balanced";
};

&mt {
    tapping-term-ms = <180>;
    quick-tap-ms = <150>;
    flavor = "balanced";
};

/ {
    behaviors {
        hm: homerow_mods {
            compatible = "zmk,behavior-hold-tap";
            label = "homerow_mods";
            bindings = <&kp>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <200>;
            flavor = "tap-preferred";
        };
    };

    keymap {
        compatible = "zmk,keymap";

        Layer0 {
            bindings = <
&kp ESC    &kp N1    &kp N2    &kp N3            &kp N4  &kp N5       &none        &none        &kp NUMBER_6  &kp N7                 &kp N8             &kp N9          &kp N0    &kp MINUS
&kp TAB    &kp Q     &kp W     &kp E             &kp R   &kp T        &none        &none        &kp Y         &kp U                  &kp I              &kp O           &kp P     &kp LBKT
&kp CAPS   &kp A     &kp S     &hm LEFT_SHIFT D  &kp F   &hm LCTRL G  &none                     &hm RCTRL H   &kp J                  &hm RIGHT_SHIFT K  &kp L           &kp SEMI  &kp SQT
&kp LSHFT  &kp Z     &kp X     &kp C             &kp V   &kp B        &none                     &kp N         &kp M                  &kp COMMA          &kp DOT         &kp FSLH  &kp INT_RO
&kp LCTRL  &kp LGUI  &kp LALT  &none             &mo 2   &mo 2        &lt 4 SPACE  &lt 5 ENTER  &kp SPACE     &mt RIGHT_SHIFT GRAVE  &none              &kp LEFT_ARROW  &kp DOWN  &kp RIGHT
            >;

            label = "MAIN";
        };

        Sub {
            bindings = <
&none  &none       &none       &none       &none       &none       &none  &none          &none         &none         &none       &none          &none       &none
&none  &kp N1      &kp N2      &kp N3      &kp N4      &kp N5      &none  &none          &kp N6        &kp N7        &kp N8      &kp N9         &kp N0      &kp RBKT
&none  &kp LS(N1)  &kp LS(N2)  &kp LS(N3)  &kp LS(N4)  &kp LS(N5)  &none                 &kp RS(N6)    &kp RS(N7)    &kp RS(N8)  &kp RS(N9)     &kp RS(N0)  &kp NUHS
&none  &none       &none       &kp F7      &kp F9      &kp Z       &none                 &kp RS(RBKT)  &kp RS(NUHS)  &kp MINUS   &kp EQUAL      &kp INT3    &kp RS(INT3)
&none  &none       &none       &to 3       &none       &none       &none  &kp BACKSPACE  &kp DELETE    &kp INT5      &none       &kp RS(MINUS)  &none       &none
            >;

            label = "Sub";
        };

        Func {
            bindings = <
&none      &none    &none    &none       &none      &none          &none  &none  &none          &none     &none          &none       &kp EQUAL  &kp INT3
&none      &none    &kp F2   &kp F3      &kp F4     &kp F5         &none  &none  &kp PG_UP      &kp HOME  &kp UP         &kp END     &none      &kp RBKT
&none      &kp F6   &kp F7   &kp F8      &kp F9     &kp F10        &none         &kp PAGE_DOWN  &kp LEFT  &kp DOWN       &kp RIGHT   &none      &kp NUHS
&kp LSHFT  &kp F11  &kp F12  &kp LA(F4)  &kp LC(Z)  &kp LG(LS(S))  &none         &kp INT5       &kp INT2  &kp BACKSPACE  &kp DELETE  &none      &none
&kp LCTRL  &none    &none    &kp LG(E)   &none      &none          &none  &none  &none          &none     &none          &none       &none      &none
            >;

            label = "Func";
        };

        MVEdit {
            bindings = <
&kp LS(ESCAPE)    &none              &none         &none          &none             &none         &none      &none  &none  &none  &none  &none  &none  &none
&none             &kp LS(BACKSPACE)  &kp HOME      &kp BACKSPACE  &kp END           &kp LC(Z)     &none      &none  &none  &none  &none  &none  &none  &none
&kp ENTER         &kp LC(R)          &kp UP_ARROW  &kp LC(B)      &kp DOWN          &kp LS(Z)     &none             &none  &none  &none  &none  &none  &none
&kp LEFT_SHIFT    &none              &kp LC(H)     &kp C          &kp LC(C)         &kp LC(V)     &none             &none  &none  &none  &none  &none  &none
&kp LEFT_CONTROL  &none              &none         &none          &kp LEFT_CONTROL  &kp LEFT_ALT  &kp SPACE  &none  &none  &none  &none  &none  &none  &none
            >;
        };

        layer_4 {
            bindings = <
&trans  &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &trans  &bt BT_CLR      &trans  &trans  &trans  &trans          &trans          &trans           &trans  &trans
&trans  &trans        &trans        &kp ESCAPE    &trans  &bt BT_CLR_ALL  &trans  &trans  &none   &mkp MB1        &mmv MOVE_UP    &mkp MB2         &trans  &trans
&trans  &trans        &trans        &trans        &trans  &trans          &trans          &none   &mmv MOVE_LEFT  &mmv MOVE_DOWN  &mmv MOVE_RIGHT  &trans  &trans
&trans  &trans        &trans        &trans        &trans  &trans          &trans          &trans  &none           &mkp MB3        &trans           &trans  &trans
&trans  &trans        &trans        &trans        &trans  &trans          &trans  &trans  &trans  &kp N4          &trans          &trans           &trans  &trans
            >;
        };

        layer_5 {
            bindings = <
&trans  &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &trans  &bt BT_CLR      &trans  &trans  &trans           &trans           &trans         &trans     &trans           &trans
&trans  &trans        &trans        &trans        &trans  &bt BT_CLR_ALL  &trans  &trans  &kp BACKSPACE    &kp KP_N7        &kp KP_N8      &kp KP_N9  &kp KP_MULTIPLY  &trans
&trans  &trans        &trans        &trans        &trans  &trans          &trans          &kp TAB          &kp KP_N4        &kp KP_N5      &kp KP_N6  &kp KP_SLASH     &trans
&trans  &trans        &trans        &trans        &trans  &trans          &trans          &kp KP_NUMBER_0  &kp KP_NUMBER_1  &kp KP_N2      &kp KP_N3  &kp KP_DOT       &trans
&trans  &trans        &trans        &trans        &trans  &trans          &trans  &trans  &trans           &trans           &kp LC(LA(B))  &trans     &trans           &trans
            >;
        };
    };
};
