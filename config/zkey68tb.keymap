    macros {
        KanaToLY0: KanaToLY0 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp INT2>, <&macro_wait_time 20>, <&to 0>;

            label = "KANATOLY0";
        };

        SingleQ: SingleQ {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LS(N7) &kp LS(N7) &kp LEFT>;
            label = "SINGLEQ";
        };

        DoubleQ: DoubleQ {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
