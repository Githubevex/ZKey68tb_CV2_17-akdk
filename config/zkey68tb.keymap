    behaviors {
        hm: homerow_mods {
            compatible = "zmk,behavior-hold-tap";
            label = "homerow_mods";
            bindings = <&kp>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <200>;
            flavor = "tap-preferred";
        };

        lt_repeat: lt_repeat {
            compatible = "zmk,behavior-hold-tap";
            label = "LAYER_TAP_REPEAT";
            bindings = <&mo>, <&kp>;

            #binding-cells = <2>;
            flavor = "hold-preferred";  // 長押しを少し強めに優先
            tapping-term-ms = <1000>;   // 長押し判定 (好みに応じて200～300で調整)
            quick-tap-ms = <900>;       // タップ+長押しでリピートさせる時間
        };
    };

    keymap {
        compatible = "zmk,keymap";

        Main {
            bindings = <
&kp ESC    &kp N1    &kp N2    &kp N3            &kp N4  &kp N5       &none               &none               &kp NUMBER_6  &kp N7                 &kp N8             &kp N9          &kp N0    &kp MINUS
&kp TAB    &kp Q     &kp W     &kp E             &kp R   &kp T        &none               &to 7               &kp Y         &kp U                  &kp I              &kp O           &kp P     &kp LBKT
&kp CAPS   &kp A     &kp S     &hm LEFT_SHIFT D  &kp F   &hm LCTRL G  &none                                   &lt 3 H       &kp J                  &hm RIGHT_SHIFT K  &kp L           &kp SEMI  &kp SQT
&kp LSHFT  &kp Z     &kp X     &kp C             &kp V   &kp B        &none                                   &kp N         &kp M                  &kp COMMA          &kp DOT         &kp FSLH  &kp INT_RO
&kp LCTRL  &kp LGUI  &kp LALT  &mo 4             &mo 2   &mo 1        &lt_repeat 7 SPACE  &lt_repeat 4 ENTER  &kp SPACE     &mt RIGHT_SHIFT GRAVE  &none              &kp LEFT_ARROW  &kp DOWN  &kp RIGHT
            >;

            label = "MAIN";
        };

        Sub {
            bindings = <
&none  &none       &none       &none       &none       &none       &none  &none          &none         &none         &none       &none          &none       &none
&none  &kp N1      &kp N2      &kp N3      &kp N4      &kp N5      &none  &none          &kp N6        &kp N7        &kp N8      &kp N9         &kp N0      &kp RBKT
&none  &kp LS(N1)  &kp LS(N2)  &kp LS(N3)  &kp LS(N4)  &kp LS(N5)  &none                 &kp RS(N6)    &kp RS(N7)    &kp RS(N8)  &kp RS(N9)     &kp RS(N0)  &kp NUHS
&none  &none       &none       &kp F7      &kp F9      &kp LS(Z)   &none                 &kp RS(RBKT)  &kp RS(NUHS)  &kp MINUS   &kp EQUAL      &kp INT3    &kp RS(INT3)
&none  &none       &none       &to 3       &none       &none       &none  &kp BACKSPACE  &kp DELETE    &kp INT5      &none       &kp RS(MINUS)  &none       &none
            >;

            label = "Sub";
        };

        Func {
            bindings = <
&none      &none    &none    &none       &none      &none          &none  &none  &none          &none     &none          &none       &kp EQUAL  &kp INT3
&none      &none    &kp F2   &kp F3      &kp F4     &kp F5         &none  &none  &kp PG_UP      &kp HOME  &kp UP         &kp END     &none      &kp RBKT
&none      &kp F6   &kp F7   &kp F8      &kp F9     &kp F10        &none         &kp PAGE_DOWN  &kp LEFT  &kp DOWN       &kp RIGHT   &kp ENTER  &kp NUHS
&kp LSHFT  &kp F11  &kp F12  &kp LA(F4)  &kp LC(Z)  &kp LG(LS(S))  &none         &kp INT5       &kp INT2  &kp BACKSPACE  &kp DELETE  &none      &none
&kp LCTRL  &none    &none    &none       &none      &none          &none  &none  &none          &none     &none          &none       &none      &none
            >;

            label = "Func";
        };

        MVEdit {
            bindings = <
&kp LS(ESCAPE)    &none              &none         &none          &none             &none         &none      &none  &none  &none  &none  &none  &none  &none
&none             &kp LS(BACKSPACE)  &kp HOME      &kp BACKSPACE  &kp END           &kp LC(Z)     &none      &none  &none  &none  &none  &none  &none  &none
&kp ENTER         &kp LC(R)          &kp UP_ARROW  &kp LC(B)      &kp DOWN          &kp LS(Z)     &none             &none  &none  &none  &none  &none  &none
&kp LEFT_SHIFT    &none              &kp LC(H)     &kp C          &kp LC(C)         &kp LC(V)     &none             &none  &none  &none  &none  &none  &none
&kp LEFT_CONTROL  &none              &none         &none          &kp LEFT_CONTROL  &kp LEFT_ALT  &kp SPACE  &none  &none  &none  &none  &none  &none  &none
            >;

            label = "MVEdit";
        };

        KeyPad {
            bindings = <
&trans  &none   &none   &none      &trans  &none   &trans  &mkp MCLK  &trans           &trans           &trans         &trans     &trans           &trans
&trans  &trans  &trans  &kp LG(E)  &trans  &none   &trans  &mkp LCLK  &mkp RCLK        &kp KP_N7        &kp KP_N8      &kp KP_N9  &kp KP_MULTIPLY  &trans
&trans  &trans  &trans  &trans     &trans  &trans  &trans             &kp TAB          &kp KP_N4        &kp KP_N5      &kp KP_N6  &kp KP_SLASH     &trans
&trans  &trans  &trans  &trans     &trans  &trans  &trans             &kp KP_NUMBER_0  &kp KP_NUMBER_1  &kp KP_N2      &kp KP_N3  &kp KP_DOT       &trans
&trans  &trans  &trans  &trans     &trans  &trans  &trans  &trans     &trans           &trans           &kp LC(LA(B))  &trans     &trans           &trans
            >;

            label = "KeyPad";
        };

        Nagi1 {
            bindings = <
&kp ESCAPE      &trans               &trans    &trans  &trans  &trans          &trans     &trans     &trans           &trans         &trans   &trans          &trans     &trans
&kp TAB         &none                &kp G     &kp W   &kp D   &kp LEFT_ARROW  &trans     &trans     &kp RIGHT_ARROW  &kp BACKSPACE  &kp DOT  &kp R           &kp EQUAL  &kp DELETE
&kp CAPSLOCK    &kp INTERNATIONAL_1  &kp SQT   &kp S   &kp T   &kp LS(Z)       &trans                &kp H            &kp N3         &kp E    &kp N4          &kp INT3   &kp LEFT_BRACKET
&kp LEFT_SHIFT  &kp MINUS            &kp V     &kp F   &kp B   &kp C           &none                 &kp Q            &kp U          &kp Y    &kp O           &kp SEMI   &kp RIGHT_BRACKET
&kp LCTRL       &kp LEFT_GUI         &kp LALT  &trans  &mo 2   &mo 6           &kp SPACE  &kp ENTER  &lt 6 SPACE      &trans         &trans   &kp LEFT_ARROW  &to 0      &kp RIGHT_ARROW
            >;

            label = "Nagi1";
        };

        Nagi2 {
            bindings = <
&none  &none  &none  &none       &none          &none           &none  &none  &none      &none        &none      &none   &none   &none
&none  &none  &kp Q  &kp L       &kp FSLH       &kp LEFT_ARROW  &none  &none  &kp RIGHT  &kp X        &kp N9     &kp N5  &kp N8  &none
&none  &kp P  &kp N  &kp I       &kp J          &kp A           &none         &kp N7     &kp K        &kp M      &kp Z   &kp N2  &none
&none  &none  &none  &kp LS(N0)  &kp LS(COMMA)  &kp NUHS        &none         &kp N6     &kp RS(DOT)  &kp COMMA  &kp N0  &none   &none
&none  &none  &none  &none       &none          &none           &none  &none  &none      &none        &none      &none   &none   &none
            >;

            label = "Nagi2";
        };

        Mouse {
            bindings = <
&trans          &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &trans  &bt BT_CLR      &trans  &none  &trans     &mkp MCLK  &trans  &trans  &trans  &trans
&trans          &trans        &trans        &kp ESCAPE    &trans  &bt BT_CLR_ALL  &trans  &none  &mkp LCLK  &mkp RCLK  &trans  &trans  &trans  &trans
&trans          &trans        &trans        &trans        &trans  &trans          &trans         &mo 3      &trans     &trans  &trans  &trans  &trans
&kp LEFT_SHIFT  &trans        &trans        &trans        &trans  &trans          &trans         &trans     &trans     &trans  &trans  &trans  &trans
&kp LCTRL       &trans        &trans        &trans        &trans  &to 0           &trans  &to 0  &trans     &none      &trans  &trans  &trans  &trans
            >;

            label = "Mouse";
        };
    };
};
